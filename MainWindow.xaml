<Window
    x:Class="PcMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PcMate"
    Width="300"
    Height="300"
    MinWidth="150"
    MinHeight="150"
    Topmost="True"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Background="#111827"
    MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8"
            Background="#1F2937"
            CornerRadius="6">
            <DockPanel LastChildFill="True">
                <TextBlock
                    DockPanel.Dock="Left"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="PcMate" />
                <TextBlock
                    DockPanel.Dock="Right"
                    FontSize="11"
                    Foreground="#CBD5E1"
                    Text="{Binding LastUpdatedText}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10">
            <Ellipse
                Fill="{Binding StateBrush}"
                Opacity="0.18"
                Stroke="{Binding StateBrush}"
                StrokeThickness="2" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding CharacterState}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#CBD5E1"
                    Text="Memory state" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="8"
            Background="#1F2937"
            CornerRadius="6">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="13"
                        Foreground="#E5E7EB"
                        Text="Memory" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding MemoryText}" />
                </DockPanel>
                <ProgressBar
                    Height="10"
                    Margin="0,8,0,6"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding MemoryUsagePercent}" />
                <TextBlock
                    FontSize="11"
                    Foreground="#CBD5E1"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
