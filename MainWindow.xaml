<Window
    x:Class="PcMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PcMate"
    Width="220"
    Height="190"
    MinWidth="48"
    MinHeight="48"
    Topmost="True"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem
                    x:Name="AlwaysOnTopMenuItem"
                    Header="Always on top"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnAlwaysOnTopClick" />
                <MenuItem
                    x:Name="ResourceBarMenuItem"
                    Header="Show resource bar"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnResourceBarClick" />
                <MenuItem
                    x:Name="SpeechBubbleMenuItem"
                    Header="Show speech bubble"
                    IsCheckable="True"
                    Click="OnSpeechBubbleClick" />
                <MenuItem
                    x:Name="ImageBorderMenuItem"
                    Header="Show image border"
                    IsCheckable="True"
                    Click="OnImageBorderClick" />
                <MenuItem Header="Resource">
                    <MenuItem
                        x:Name="MemoryResourceMenuItem"
                        Header="Memory"
                        IsCheckable="True"
                        IsChecked="True"
                        Tag="Memory"
                        Click="OnResourceMenuItemClick" />
                    <MenuItem
                        x:Name="CpuResourceMenuItem"
                        Header="CPU"
                        IsCheckable="True"
                        Tag="Cpu"
                        Click="OnResourceMenuItemClick" />
                    <MenuItem
                        x:Name="GpuResourceMenuItem"
                        Header="GPU"
                        IsCheckable="True"
                        Tag="Gpu"
                        Click="OnResourceMenuItemClick" />
                </MenuItem>
                <MenuItem Header="State thresholds">
                    <MenuItem
                        x:Name="MemoryThresholdMenuItem"
                        Tag="Memory"
                        Click="OnThresholdMenuItemClick" />
                    <MenuItem
                        x:Name="CpuThresholdMenuItem"
                        Tag="Cpu"
                        Click="OnThresholdMenuItemClick" />
                    <MenuItem
                        x:Name="GpuThresholdMenuItem"
                        Tag="Gpu"
                        Click="OnThresholdMenuItemClick" />
                </MenuItem>
                <MenuItem x:Name="CharacterMenuItem" Header="Character" />
                <MenuItem Header="Animation speed">
                    <MenuItem
                        x:Name="SpeedHalfMenuItem"
                        Header="0.5x"
                        IsCheckable="True"
                        Tag="0.5"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedThreeQuarterMenuItem"
                        Header="0.75x"
                        IsCheckable="True"
                        Tag="0.75"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedNormalMenuItem"
                        Header="1x"
                        IsCheckable="True"
                        IsChecked="True"
                        Tag="1"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedOneAndHalfMenuItem"
                        Header="1.5x"
                        IsCheckable="True"
                        Tag="1.5"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedDoubleMenuItem"
                        Header="2x"
                        IsCheckable="True"
                        Tag="2"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedTripleMenuItem"
                        Header="3x"
                        IsCheckable="True"
                        Tag="3"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedQuadrupleMenuItem"
                        Header="4x"
                        IsCheckable="True"
                        Tag="4"
                        Click="OnAnimationSpeedMenuItemClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Reset size" Click="OnResetSizeClick" />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CharacterStage"
            Grid.Row="0"
            Margin="4">
            <Image
                x:Name="CharacterImage"
                MouseLeftButtonDown="OnCharacterMouseLeftButtonDown"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Source="{Binding CharacterFrame}"
                Stretch="Uniform" />

            <Border
                x:Name="CharacterImageBoundary"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#FFFF2D55"
                BorderThickness="1"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                Visibility="Collapsed" />

            <Grid
                x:Name="SpeechBubble"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="4,0,4,0"
                Panel.ZIndex="2"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="SpeechBubbleBody"
                    Width="180"
                    Height="64"
                    MinWidth="110"
                    MinHeight="48"
                    Padding="8,6"
                    Background="#F2FFFFFF"
                    BorderBrush="#CC111827"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <TextBlock
                            Margin="0,0,12,12"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#111827"
                            LineHeight="14"
                            Text="{Binding SpeechBubbleText}"
                            TextWrapping="Wrap" />
                        <primitives:Thumb
                            x:Name="SpeechBubbleResizeThumb"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Cursor="SizeNWSE"
                            DragDelta="OnSpeechBubbleResizeThumbDragDelta">
                            <primitives:Thumb.Template>
                                <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                    <Grid Background="Transparent">
                                        <Path
                                            Data="M 3 12 L 12 3 M 7 12 L 12 7"
                                            Stroke="#CC111827"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="4" />
                                        <Path
                                            Data="M 3 12 L 12 3 M 7 12 L 12 7"
                                            Stroke="#FF22D3EE"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Grid>
                                </ControlTemplate>
                            </primitives:Thumb.Template>
                        </primitives:Thumb>
                    </Grid>
                </Border>

                <Path
                    Grid.Row="1"
                    Width="14"
                    Height="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Data="M 0 0 L 14 0 L 7 8 Z"
                    Fill="#F2FFFFFF"
                    Stroke="#CC111827"
                    StrokeThickness="1" />
            </Grid>

            <primitives:Thumb
                x:Name="ResizeThumb"
                Width="18"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Cursor="SizeNESW"
                DragDelta="OnResizeThumbDragDelta"
                Panel.ZIndex="3">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid Background="Transparent">
                            <Path
                                Data="M 2 16 L 16 2 M 2 11 L 11 2 M 2 6 L 6 2"
                                Stroke="#CC111827"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="5" />
                            <Path
                                Data="M 2 16 L 16 2 M 2 11 L 11 2 M 2 6 L 6 2"
                                Stroke="#FF22D3EE"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>

        <StackPanel
            x:Name="ResourceBarPanel"
            Grid.Row="1"
            Margin="8,0,8,4">
            <TextBlock
                Margin="0,0,0,3"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding ResourceUsageText}">
                <TextBlock.Effect>
                    <DropShadowEffect
                        BlurRadius="2"
                        Direction="315"
                        Opacity="0.9"
                        ShadowDepth="1"
                        Color="#111827" />
                </TextBlock.Effect>
            </TextBlock>
            <ProgressBar
                x:Name="ResourceProgressBar"
                Height="8"
                Maximum="100"
                Minimum="0"
                Value="{Binding ResourceUsagePercent, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
