<Window
    x:Class="PcMate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PcMate"
    Width="220"
    Height="190"
    MinWidth="48"
    MinHeight="48"
    Topmost="True"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem
                    x:Name="AlwaysOnTopMenuItem"
                    Header="{Binding [MenuAlwaysOnTop], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnAlwaysOnTopClick" />
                <MenuItem
                    x:Name="ResourceBarMenuItem"
                    Header="{Binding [MenuShowResourceBar], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnResourceBarClick" />
                <MenuItem
                    x:Name="SpeechBubbleMenuItem"
                    Header="{Binding [MenuShowSpeechBubble], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsCheckable="True"
                    Click="OnSpeechBubbleClick" />
                <MenuItem
                    x:Name="ImageBorderMenuItem"
                    Header="{Binding [MenuShowImageBorder], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsCheckable="True"
                    Click="OnImageBorderClick" />
                <MenuItem
                    x:Name="DarkModeMenuItem"
                    Header="{Binding [MenuDarkMode], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsCheckable="True"
                    Click="OnDarkModeClick" />
                <MenuItem Header="{Binding [MenuResource], Source={x:Static loc:LocalizationManager.Instance}}">
                    <MenuItem
                        x:Name="MemoryResourceMenuItem"
                        Header="{Binding [ResourceMemory], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        IsChecked="True"
                        Tag="Memory"
                        Click="OnResourceMenuItemClick" />
                    <MenuItem
                        x:Name="CpuResourceMenuItem"
                        Header="{Binding [ResourceCpu], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="Cpu"
                        Click="OnResourceMenuItemClick" />
                    <MenuItem
                        x:Name="GpuResourceMenuItem"
                        Header="{Binding [ResourceGpu], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="Gpu"
                        Click="OnResourceMenuItemClick" />
                    <MenuItem
                        x:Name="NetworkResourceMenuItem"
                        Header="{Binding [ResourceNetwork], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="Network"
                        Click="OnResourceMenuItemClick" />
                </MenuItem>
                <MenuItem Header="{Binding [MenuStateThresholds], Source={x:Static loc:LocalizationManager.Instance}}">
                    <MenuItem
                        x:Name="MemoryThresholdMenuItem"
                        Tag="Memory"
                        Click="OnThresholdMenuItemClick" />
                    <MenuItem
                        x:Name="CpuThresholdMenuItem"
                        Tag="Cpu"
                        Click="OnThresholdMenuItemClick" />
                    <MenuItem
                        x:Name="GpuThresholdMenuItem"
                        Tag="Gpu"
                        Click="OnThresholdMenuItemClick" />
                    <MenuItem
                        x:Name="NetworkThresholdMenuItem"
                        Tag="Network"
                        Click="OnThresholdMenuItemClick" />
                </MenuItem>
                <MenuItem
                    x:Name="CharacterMenuItem"
                    Header="{Binding [MenuCharacter], Source={x:Static loc:LocalizationManager.Instance}}" />
                <MenuItem Header="{Binding [MenuAnimationSpeed], Source={x:Static loc:LocalizationManager.Instance}}">
                    <MenuItem
                        x:Name="SpeedHalfMenuItem"
                        Header="0.5x"
                        IsCheckable="True"
                        Tag="0.5"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedThreeQuarterMenuItem"
                        Header="0.75x"
                        IsCheckable="True"
                        Tag="0.75"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedNormalMenuItem"
                        Header="1x"
                        IsCheckable="True"
                        IsChecked="True"
                        Tag="1"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedOneAndHalfMenuItem"
                        Header="1.5x"
                        IsCheckable="True"
                        Tag="1.5"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedDoubleMenuItem"
                        Header="2x"
                        IsCheckable="True"
                        Tag="2"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedTripleMenuItem"
                        Header="3x"
                        IsCheckable="True"
                        Tag="3"
                        Click="OnAnimationSpeedMenuItemClick" />
                    <MenuItem
                        x:Name="SpeedQuadrupleMenuItem"
                        Header="4x"
                        IsCheckable="True"
                        Tag="4"
                        Click="OnAnimationSpeedMenuItemClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding [MenuLanguage], Source={x:Static loc:LocalizationManager.Instance}}">
                    <MenuItem
                        x:Name="SystemLanguageMenuItem"
                        Header="{Binding [LanguageSystem], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="system"
                        Click="OnLanguageMenuItemClick" />
                    <MenuItem
                        x:Name="EnglishLanguageMenuItem"
                        Header="{Binding [LanguageEnglish], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="en"
                        Click="OnLanguageMenuItemClick" />
                    <MenuItem
                        x:Name="KoreanLanguageMenuItem"
                        Header="{Binding [LanguageKorean], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsCheckable="True"
                        Tag="ko"
                        Click="OnLanguageMenuItemClick" />
                </MenuItem>
                <MenuItem
                    Header="{Binding [MenuHelpTutorial], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="OnHelpClick" />
                <Separator />
                <MenuItem
                    Header="{Binding [MenuResetSize], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="OnResetSizeClick" />
                <MenuItem
                    Header="{Binding [MenuExit], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CharacterStage"
            Grid.Row="0"
            Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SpeechBubbleHostRow" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image
                x:Name="CharacterImage"
                Grid.Row="1"
                MouseLeftButtonDown="OnCharacterMouseLeftButtonDown"
                MouseLeftButtonUp="OnCharacterMouseLeftButtonUp"
                MouseMove="OnCharacterMouseMove"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Source="{Binding CharacterFrame}"
                Stretch="Uniform" />

            <Border
                x:Name="CharacterImageBoundary"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#FFFF2D55"
                BorderThickness="1"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                Visibility="Collapsed" />

            <Grid
                x:Name="SpeechBubble"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="4,0,4,8"
                Panel.ZIndex="2"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="SpeechBubbleBody"
                    MinWidth="64"
                    MinHeight="34"
                    MaxWidth="420"
                    MaxHeight="240"
                    Padding="8,6"
                    Background="#F2FFFFFF"
                    BorderBrush="#CC111827"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        LineHeight="14"
                        Text="{Binding SpeechBubbleText}"
                        TextWrapping="Wrap" />
                </Border>

                <Path
                    Grid.Row="1"
                    Width="14"
                    Height="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Data="M 0 0 L 14 0 L 7 8 Z"
                    Fill="#F2FFFFFF"
                    Stroke="#CC111827"
                    StrokeThickness="1" />
            </Grid>

            <primitives:Thumb
                x:Name="ResizeThumb"
                Grid.Row="1"
                Width="18"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Cursor="SizeNESW"
                DragDelta="OnResizeThumbDragDelta"
                Panel.ZIndex="3">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid Background="Transparent">
                            <Path
                                Data="M 2 16 L 16 2 M 2 11 L 11 2 M 2 6 L 6 2"
                                Stroke="#CC111827"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="5" />
                            <Path
                                Data="M 2 16 L 16 2 M 2 11 L 11 2 M 2 6 L 6 2"
                                Stroke="#FF22D3EE"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>

        <StackPanel
            x:Name="ResourceBarPanel"
            Grid.Row="1"
            Margin="8,0,8,4">
            <TextBlock
                x:Name="ResourceUsageTextBlock"
                Margin="0,0,0,3"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#111827"
                Text="{Binding ResourceUsageText}">
                <TextBlock.Effect>
                    <DropShadowEffect
                        BlurRadius="2"
                        Direction="315"
                        Opacity="0.9"
                        ShadowDepth="1"
                        Color="#F9FAFB" />
                </TextBlock.Effect>
            </TextBlock>
            <ProgressBar
                x:Name="ResourceProgressBar"
                Height="8"
                Maximum="{Binding ResourceUsageMaximum, Mode=OneWay}"
                Minimum="0"
                Value="{Binding ResourceUsageValue, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
