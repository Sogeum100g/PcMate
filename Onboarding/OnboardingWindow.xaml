<Window
    x:Class="PcMate.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding [OnboardingWindowTitle], Source={x:Static loc:LocalizationManager.Instance}}"
    Width="720"
    Height="660"
    MinWidth="620"
    MinHeight="520"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Inter, Segoe UI"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF0066CC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PrimarySurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="22"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#FF0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="#FF1D1D1F" />
            <Setter Property="Background" Value="#A3D2D2D7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CloseSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="22"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border
            Margin="1"
            Background="#FFF5F5F7"
            BorderBrush="#FFE0E0E0"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="24,0,14,0"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Foreground="#FF1D1D1F"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{Binding [AppName], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="#FF7A7A7A"
                        FontSize="12"
                        Text="{Binding [OnboardingHelp], Source={x:Static loc:LocalizationManager.Instance}}" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnCloseClick"
                    Content="×"
                    Style="{StaticResource CloseButtonStyle}" />
            </Grid>

            <Border Grid.Row="1" Background="White">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,26,36,30">
                        <Grid Height="116">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Ellipse
                                    Width="108"
                                    Height="108"
                                    Fill="#FFF5F5F7" />
                                <Image
                                    x:Name="HelpImage"
                                    Width="96"
                                    Height="96"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Stretch="Uniform">
                                    <Image.Effect>
                                        <DropShadowEffect
                                            BlurRadius="30"
                                            Direction="315"
                                            Opacity="0.22"
                                            ShadowDepth="5"
                                            Color="#FF000000" />
                                    </Image.Effect>
                                </Image>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Foreground="#FF1D1D1F"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    LineHeight="35"
                                    Text="{Binding [OnboardingSingleTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,18,0,20"
                            Background="#FFF0F0F0" />

                        <TextBlock
                            Foreground="#FF1D1D1F"
                            FontSize="17"
                            FontWeight="Normal"
                            LineHeight="25"
                            Text="{Binding [OnboardingSingleBody], Source={x:Static loc:LocalizationManager.Instance}}"
                            TextOptions.TextFormattingMode="Display"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="24,0">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#FF7A7A7A"
                    FontSize="12"
                    Text="{Binding [OnboardingReopenHint], Source={x:Static loc:LocalizationManager.Instance}}" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnDoneClick"
                    Content="{Binding [OnboardingConfirm], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
            </Grid>
        </Border>

        <primitives:Thumb
            Width="22"
            Height="22"
            Margin="0,0,5,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Cursor="SizeNWSE"
            DragDelta="OnResizeThumbDragDelta"
            Panel.ZIndex="10">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Background="Transparent">
                        <Path
                            Data="M 6 17 L 17 6 M 11 17 L 17 11"
                            Stroke="#FF7A7A7A"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
