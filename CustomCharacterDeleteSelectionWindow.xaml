<Window
    x:Class="PcMate.CustomCharacterDeleteSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete Characters"
    Width="340"
    Height="320"
    MinWidth="320"
    MinHeight="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="#374151"
            Text="Choose one or more custom characters to delete." />

        <ListBox
            x:Name="CharacterListBox"
            Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Padding="2"
                        Content="{Binding Character.DisplayName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <Button
                Width="80"
                Content="Delete"
                IsDefault="True"
                Click="OnDeleteClick" />
        </StackPanel>
    </Grid>
</Window>
