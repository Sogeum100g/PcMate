<Window
    x:Class="PcMate.Settings.ResourceThresholdSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="State Thresholds"
    Width="360"
    Height="260"
    MinWidth="340"
    MinHeight="260"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid
        Width="300"
        Margin="16"
        HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="DescriptionTextBlock"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Foreground="#374151"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Sitting from" />
        <TextBox
            x:Name="SittingTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Walking from" />
        <TextBox
            x:Name="WalkingTextBox"
            Grid.Row="4"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            Grid.Row="4"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Running from" />
        <TextBox
            x:Name="RunningTextBox"
            Grid.Row="6"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            Grid.Row="6"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <StackPanel
            Grid.Row="8"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <Button
                Width="80"
                Content="Save"
                IsDefault="True"
                Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
