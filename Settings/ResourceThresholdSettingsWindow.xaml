<Window
    x:Class="PcMate.Settings.ResourceThresholdSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding [MenuStateThresholds], Source={x:Static loc:LocalizationManager.Instance}}"
    Width="360"
    Height="260"
    MinWidth="340"
    MinHeight="260"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid
        Width="300"
        Margin="16"
        HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="DescriptionTextBlock"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Foreground="#374151"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [ThresholdStandingFrom], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="SittingTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            x:Name="SittingUnitTextBlock"
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [ThresholdWalkingFrom], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="WalkingTextBox"
            Grid.Row="4"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            x:Name="WalkingUnitTextBlock"
            Grid.Row="4"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [ThresholdRunningFrom], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="RunningTextBox"
            Grid.Row="6"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Right"
            MinHeight="26" />
        <TextBlock
            x:Name="RunningUnitTextBlock"
            Grid.Row="6"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text=" %" />

        <StackPanel
            Grid.Row="8"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="{Binding [ActionCancel], Source={x:Static loc:LocalizationManager.Instance}}"
                IsCancel="True" />
            <Button
                Width="80"
                Content="{Binding [ActionSave], Source={x:Static loc:LocalizationManager.Instance}}"
                IsDefault="True"
                Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
