<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="assets\app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\characters\blob\**\*.gif" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\characters\blob\**\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\characters\blob\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\characters\blob\**\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\characters\blob\**\*.jpeg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CleanPublishedCharacterAssets" BeforeTargets="Publish">
    <RemoveDir Directories="$(PublishDir)assets\characters" />
  </Target>

  <Target Name="CopyAppIconToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <PublishCharacterAssets Include="$(MSBuildProjectDirectory)\assets\characters\blob\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)assets" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\assets\app.ico"
      DestinationFiles="$(PublishDir)assets\app.ico"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(PublishCharacterAssets)"
      DestinationFiles="@(PublishCharacterAssets->'$(PublishDir)assets\characters\blob\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
