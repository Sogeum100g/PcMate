<Window
    x:Class="PcMate.CustomCharacter.CustomCharacterDeleteSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding [CharacterDeleteTitle], Source={x:Static loc:LocalizationManager.Instance}}"
    Width="340"
    Height="320"
    MinWidth="320"
    MinHeight="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="#374151"
            Text="{Binding [CharacterDeleteDescription], Source={x:Static loc:LocalizationManager.Instance}}" />

        <ListBox
            x:Name="CharacterListBox"
            Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Padding="2"
                        Content="{Binding Character.DisplayName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="{Binding [ActionCancel], Source={x:Static loc:LocalizationManager.Instance}}"
                IsCancel="True" />
            <Button
                Width="80"
                Content="{Binding [ActionDelete], Source={x:Static loc:LocalizationManager.Instance}}"
                IsDefault="True"
                Click="OnDeleteClick" />
        </StackPanel>
    </Grid>
</Window>
