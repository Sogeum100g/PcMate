<Window
    x:Class="PcMate.CustomCharacter.CustomCharacterRegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Register Character"
    Width="460"
    Height="260"
    MinWidth="420"
    MinHeight="240"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="4"
            FontSize="12"
            Foreground="#374151"
            Text="Choose a menu name and three image files for the character states."
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Name" />
        <TextBox
            x:Name="CharacterNameTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            MinHeight="26" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Standing" />
        <TextBox
            x:Name="StandingPathTextBox"
            Grid.Row="4"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="4"
            Grid.Column="3"
            Content="Browse"
            Click="OnBrowseStandingClick" />

        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Walking" />
        <TextBox
            x:Name="WalkingPathTextBox"
            Grid.Row="6"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="6"
            Grid.Column="3"
            Content="Browse"
            Click="OnBrowseWalkingClick" />

        <TextBlock
            Grid.Row="8"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Running" />
        <TextBox
            x:Name="RunningPathTextBox"
            Grid.Row="8"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="8"
            Grid.Column="3"
            Content="Browse"
            Click="OnBrowseRunningClick" />

        <StackPanel
            Grid.Row="10"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="Cancel"
                IsCancel="True" />
            <Button
                x:Name="RegisterButton"
                Width="88"
                Content="Register"
                IsDefault="True"
                Click="OnRegisterClick" />
        </StackPanel>
    </Grid>
</Window>
