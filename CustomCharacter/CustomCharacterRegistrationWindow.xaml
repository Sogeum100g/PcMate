<Window
    x:Class="PcMate.CustomCharacter.CustomCharacterRegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding [CharacterRegisterTitle], Source={x:Static loc:LocalizationManager.Instance}}"
    Width="540"
    MinWidth="500"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="6"
            FontSize="12"
            Foreground="#374151"
            Text="{Binding [CharacterRegisterDescription], Source={x:Static loc:LocalizationManager.Instance}}"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [CharacterName], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="CharacterNameTextBox"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            MinHeight="26" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [StateSleeping], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="SleepingPathTextBox"
            Grid.Row="4"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="4"
            Grid.Column="3"
            Content="{Binding [ActionBrowse], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnBrowseSleepingClick" />
        <Button
            Grid.Row="4"
            Grid.Column="5"
            Content="{Binding [ActionClear], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnClearSleepingClick" />

        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [StateStanding], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="StandingPathTextBox"
            Grid.Row="6"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="6"
            Grid.Column="3"
            Content="{Binding [ActionBrowse], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnBrowseStandingClick" />
        <Button
            Grid.Row="6"
            Grid.Column="5"
            Content="{Binding [ActionClear], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnClearStandingClick" />

        <TextBlock
            Grid.Row="8"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [StateWalking], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="WalkingPathTextBox"
            Grid.Row="8"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="8"
            Grid.Column="3"
            Content="{Binding [ActionBrowse], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnBrowseWalkingClick" />
        <Button
            Grid.Row="8"
            Grid.Column="5"
            Content="{Binding [ActionClear], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnClearWalkingClick" />

        <TextBlock
            Grid.Row="10"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding [StateRunning], Source={x:Static loc:LocalizationManager.Instance}}" />
        <TextBox
            x:Name="RunningPathTextBox"
            Grid.Row="10"
            Grid.Column="1"
            IsReadOnly="True"
            MinHeight="26" />
        <Button
            Grid.Row="10"
            Grid.Column="3"
            Content="{Binding [ActionBrowse], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnBrowseRunningClick" />
        <Button
            Grid.Row="10"
            Grid.Column="5"
            Content="{Binding [ActionClear], Source={x:Static loc:LocalizationManager.Instance}}"
            Click="OnClearRunningClick" />

        <Button
            Grid.Row="12"
            Grid.Column="3"
            MinHeight="26"
            Content="{Binding [ActionCancel], Source={x:Static loc:LocalizationManager.Instance}}"
            IsCancel="True" />
        <Button
            x:Name="RegisterButton"
            Grid.Row="12"
            Grid.Column="5"
            MinHeight="26"
            Content="{Binding [ActionRegister], Source={x:Static loc:LocalizationManager.Instance}}"
            IsDefault="True"
            Click="OnRegisterClick" />
    </Grid>
</Window>
