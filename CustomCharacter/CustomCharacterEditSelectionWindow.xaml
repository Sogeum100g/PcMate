<Window
    x:Class="PcMate.CustomCharacter.CustomCharacterEditSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:PcMate.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding [CharacterEditTitle], Source={x:Static loc:LocalizationManager.Instance}}"
    Width="320"
    Height="300"
    MinWidth="300"
    MinHeight="260"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="#374151"
            Text="{Binding [CharacterEditDescription], Source={x:Static loc:LocalizationManager.Instance}}" />

        <ListBox
            x:Name="CharacterListBox"
            Grid.Row="2"
            DisplayMemberPath="DisplayName" />

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Content="{Binding [ActionCancel], Source={x:Static loc:LocalizationManager.Instance}}"
                IsCancel="True" />
            <Button
                Width="80"
                Content="{Binding [ActionEdit], Source={x:Static loc:LocalizationManager.Instance}}"
                IsDefault="True"
                Click="OnEditClick" />
        </StackPanel>
    </Grid>
</Window>
